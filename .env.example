PORT=3000
CINEVERSE_DB_PATH=storage/cineverse.sqlite
CINEVERSE_STORAGE_DIR=storage
CINEVERSE_SESSION_DAYS=14
CINEVERSE_MAX_UPLOAD_BYTES=10485760
CINEVERSE_DEMO_ENABLED=true
CINEVERSE_CORS_ORIGIN=
CINEVERSE_PUBLIC_ORIGIN=
CINEVERSE_COOKIE_SECURE=false

# AI is explicit: local development defaults to the deterministic Demo provider
# when no provider is configured. In production, set CINEVERSE_AI_PROVIDER and
# all provider credentials below, or disable demo with CINEVERSE_DEMO_ENABLED=false.
CINEVERSE_AI_PROVIDER=
CINEVERSE_AI_ALLOW_DEMO_FALLBACK=false

# OpenAI-compatible chat-completions adapter. Keep these values server-side.
CINEVERSE_AI_BASE_URL=
CINEVERSE_AI_API_KEY=
CINEVERSE_AI_MODEL=
